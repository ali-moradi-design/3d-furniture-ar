{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["/index.html", "/products/marlow-lounge-chair/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --use-gl=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    }
  }
}
